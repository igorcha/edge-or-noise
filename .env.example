# LLM settings for local runs. Copy this file to .env in the same folder (the repo root, next to
# pyproject.toml) and fill in a key:  cp .env.example .env
#
# .env is gitignored. This file is committed, so never put a real key in it.
# Read by engine/llm/client.py for the API server, scripts/eval_llm.py and `pytest -m network`.
# Variables already set in the shell win over this file. One KEY=value per line, comments on their
# own line. Restart the API server after editing.

# Which model parses strategies: nemotron (the deployed one, required for the hackathon) or anthropic.
LLM_PROVIDER=nemotron

# --- Nemotron on Nebius Token Factory (LLM_PROVIDER=nemotron) ---
NEBIUS_API_KEY=
# NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
# How JSON is requested: json_object | json_schema | off
# NEBIUS_JSON_MODE=json_object
# Nemotron's reasoning mode: off | on | default
# NEBIUS_THINKING=off
# Seconds per call. Parsing makes up to two calls inside one request, so keep it under half
# Gunicorn's timeout.
# NEBIUS_TIMEOUT_S=60

# --- Claude on the Anthropic API (LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
# claude-haiku-5-5 (default) or claude-sonnet-5-5
# ANTHROPIC_MODEL=claude-haiku-5-5
# LLM_TIMEOUT_S=60
